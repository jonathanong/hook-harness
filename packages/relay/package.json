{
  "name": "@hook-harness/relay",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./keys": "./src/keys.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --minify --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@hook-harness/protocol": "workspace:*"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  }
}
